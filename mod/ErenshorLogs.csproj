<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ErenshorLogs</AssemblyName>
    <RootNamespace>ErenshorLogs</RootNamespace>

    <!-- Roslyn Analyzers -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Suppress specific warnings that don't apply to mods -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Exclude tests directory from main project compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Copy NuGet dependencies to output (needed for ILRepack) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx -->
    <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.*" PrivateAssets="all" />

    <!-- C# language feature polyfills for netstandard2.1 (records, init, required) -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />

    <!-- Dependency injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />

    <!-- JSON serialization (Newtonsoft.Json works with Unity Mono runtime) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />

    <!-- WebSocket server for live streaming -->
    <PackageReference Include="Fleck" Version="1.*" />

    <!-- ILRepack for merging dependencies into single DLL -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" />
  </ItemGroup>

  <!-- Version generation from git -->
  <Target Name="GetGitVersion" BeforeTargets="GeneratePluginInfo">
    <!-- Get version from git in semver-compliant CalVer format (YYYY.M.D+COMMITHASH) -->
    <!-- Transform YYYY-MM-DD+hash to YYYY.M.D+hash (remove leading zeros for semver) -->
    <Exec Command="git log -1 --format=&quot;%cs+%h&quot; | sed 's/-/./g' | sed 's/\.0\([0-9]\)/.\1/g'"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitVersionRaw" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>

    <!-- For Release builds: check if working tree is dirty and fail if so -->
    <Exec Command="git status --porcelain"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          EchoOff="true"
          Condition="'$(Configuration)' == 'Release'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatusRelease" />
    </Exec>

    <!-- Fail Release build if working tree is dirty -->
    <Error Text="❌ Cannot build Release with uncommitted changes. Commit or stash your changes first. Run 'git status' to see uncommitted changes."
           Condition="'$(Configuration)' == 'Release' AND '$(GitStatusRelease)' != ''" />

    <!-- For Debug builds: check if dirty and append timestamp -->
    <Exec Command="git status --porcelain"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          EchoOff="true"
          Condition="'$(Configuration)' == 'Debug'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatusDebug" />
    </Exec>

    <!-- Build version string -->
    <PropertyGroup Condition="'$(GitExitCode)' == '0' AND '$(GitVersionRaw)' != ''">
      <GitVersionClean>$(GitVersionRaw.Trim())</GitVersionClean>
      <!-- Add -dirty-timestamp for Debug builds with uncommitted changes -->
      <GitVersion Condition="'$(Configuration)' == 'Debug' AND '$(GitStatusDebug)' != ''">$(GitVersionClean)-dirty-$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))</GitVersion>
      <GitVersion Condition="'$(GitVersion)' == ''">$(GitVersionClean)</GitVersion>
    </PropertyGroup>

    <!-- Fallback if git fails -->
    <PropertyGroup Condition="'$(GitExitCode)' != '0' OR '$(GitVersionRaw)' == ''">
      <GitVersion>0.0.0-$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))</GitVersion>
      <GitVersionWarning>⚠️  Git not available, using fallback version</GitVersionWarning>
    </PropertyGroup>

    <!-- Final fallback in case nothing else set it -->
    <PropertyGroup Condition="'$(GitVersion)' == ''">
      <GitVersion>0.0.0-unknown</GitVersion>
      <GitVersionWarning>⚠️  Version could not be determined</GitVersionWarning>
    </PropertyGroup>

    <Message Text="$(GitVersionWarning)" Importance="high" Condition="'$(GitVersionWarning)' != ''" />
    <Message Text="📦 Build version: $(GitVersion)" Importance="high" />
  </Target>

  <!-- Generate PluginInfo.g.cs with version from git -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
      <PluginInfoLine1>namespace ErenshorLogs%3B</PluginInfoLine1>
      <PluginInfoLine2>internal static partial class PluginInfo { public const string Version = "$(GitVersion)"%3B }</PluginInfoLine2>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginInfoFile)" Lines="$(PluginInfoLine1)" Overwrite="true" />
    <WriteLinesToFile File="$(PluginInfoFile)" Lines="$(PluginInfoLine2)" Overwrite="false" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Game assembly references (copied via erenshor setup) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>lib/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ILRepack configuration is in ILRepack.targets -->
  <!-- The ILRepack.Lib.MSBuild.Task package automatically imports it -->

</Project>
