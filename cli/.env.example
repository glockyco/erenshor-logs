# Erenshor Development CLI Configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: Path to Erenshor game installation
#
# Windows:
#   ERENSHOR_PATH=C:\Program Files (x86)\Steam\steamapps\common\Erenshor
#
# macOS (CrossOver):
#   ERENSHOR_PATH=~/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam/steamapps/common/Erenshor
ERENSHOR_PATH=

# macOS only: CrossOver bottle name (used by 'erenshor launch' and 'erenshor bepinex')
CROSSOVER_BOTTLE=Steam

# macOS only: Path to CrossOver.app (defaults to /Applications/CrossOver.app)
# CROSSOVER_PATH=/Applications/CrossOver.app

# macOS/Linux only: Path to .NET 8 runtime (required for 'erenshor decompile')
# ilspycmd requires .NET 8, which may not be the default dotnet installation.
#
# Homebrew (macOS): /opt/homebrew/opt/dotnet@8/libexec
# DOTNET8_ROOT=/opt/homebrew/opt/dotnet@8/libexec
