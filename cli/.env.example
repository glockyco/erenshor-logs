# Erenshor Development CLI Configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: Path to Erenshor game installation
#
# Windows:
#   ERENSHOR_PATH=C:\Program Files (x86)\Steam\steamapps\common\Erenshor
#
# macOS (CrossOver):
#   ERENSHOR_PATH=~/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam/steamapps/common/Erenshor
ERENSHOR_PATH=

# macOS only: CrossOver bottle name (used by 'erenshor launch' command)
CROSSOVER_BOTTLE=Steam
